# Kopie als .env.local anlegen und ausfuellen. .env.local wird NICHT ins Git-Repo uebernommen.

# App-Registrierung (Entra Admin Center). Die Client-ID ist kein Geheimnis.
MS_CLIENT_ID=6e34eda3-98af-41ae-9d82-903f0b27feeb

# Clientschluessel (Wert, nicht die Geheimnis-ID). GEHEIM - nur hier eintragen.
MS_CLIENT_SECRET=

# consumers = nur private Konten, common = privat + geschaeftlich, organizations = nur geschaeftlich.
# NICHT die Verzeichnis-ID einsetzen: private Konten gehoeren zu keinem Tenant.
MS_AUTHORITY=consumers

MS_REDIRECT_URI=http://localhost:3000/api/auth/callback

# 32 Zufallsbytes, base64. Erzeugen mit: npm run gen-key
TOKEN_ENC_KEY=

PORT=3000

# Optional: nur diese Microsoft-Konten duerfen sich verbinden (kommagetrennt, klein geschrieben).
ALLOWED_ACCOUNTS=

# Neon Postgres (Vercel-Marketplace-Integration setzt DATABASE_URL automatisch). Lokal leer lassen = Datei .data/store.json.
DATABASE_URL=
